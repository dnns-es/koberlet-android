<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 en adelante mira aqui para las copias en la nube y para el
     traspaso de un movil a otro. Se excluye TODO: la boveda no sale del aparato
     por un camino que el dueño no ha elegido. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
